config_version=5

[application]

config/name="RealBeanBoy"
run/main_scene="uid://odmhhm3ivxgn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

GameState="*uid://e5ew25ie3obu"

[display]

window/size/viewport_width=128
window/size/viewport_height=128
window/size/window_width_override=512
window/size/window_height_override=512
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="RealBeanBoy"

